# Copy to server/.env (not in git) and set the access code.
YOLO_ACCESS_CODE=change-me
# A hook module called for every detected frame, e.g. server.hooks.example. Empty: no hook.
YOLO_HOOK=
# onnxruntime threads per detection (the CPU may be shared with other services)
YOLO_THREADS=1
# Frames per second per camera (0: no cap; cameras still take turns), and connections (cameras + subscribers)
YOLO_MAX_FPS=0
YOLO_MAX_CLIENTS=8
# With onnxruntime-gpu on a GPU server: CUDAExecutionProvider,CPUExecutionProvider
YOLO_PROVIDERS=CPUExecutionProvider
